<Window x:Class="WebDisplay.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="网页展示器">
 <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border x:Name="Toolbar" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="20,12">
   <Grid ColumnSpacing="20">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel VerticalAlignment="Center" Spacing="2"><TextBlock x:Name="AppTitleText" Text="网页展示器" Style="{StaticResource SubtitleTextBlockStyle}"/><TextBlock x:Name="AddressText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/></StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
     <Button x:Name="RefreshButton" Click="RefreshClick" ToolTipService.ToolTip="刷新 · Ctrl+R"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE72C;" FontSize="16"/><TextBlock x:Name="RefreshButtonText" Text="刷新"/></StackPanel></Button>
     <Button x:Name="FullscreenButton" Click="FullscreenClick" ToolTipService.ToolTip="全屏 · F11"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE740;" FontSize="16"/><TextBlock x:Name="FullscreenButtonText" Text="全屏"/></StackPanel></Button>
     <Button x:Name="SettingsButton" Click="SettingsClick" ToolTipService.ToolTip="设置 · Ctrl+,"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE713;" FontSize="16"/><TextBlock x:Name="SettingsButtonText" Text="设置"/></StackPanel></Button>
    </StackPanel>
   </Grid>
  </Border>
  <InfoBar x:Name="RecoveryBanner" Grid.Row="1" IsOpen="False" IsClosable="False" Severity="Warning" Title="等待恢复">
   <InfoBar.ActionButton><Button x:Name="RetryButton" Content="立即重试" Click="RefreshClick"/></InfoBar.ActionButton>
  </InfoBar>
  <Grid x:Name="BrowserHost" Grid.Row="2" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"/>
  <Border x:Name="StatusBar" Grid.Row="3" Padding="20,8" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" Text="准备就绪" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock x:Name="ShortcutHintText" Grid.Column="1" Margin="16,0,0,0" Text="F11 全屏  ·  Esc 返回  ·  Ctrl+, 设置" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></Grid>
  </Border>
 </Grid>
</Window>