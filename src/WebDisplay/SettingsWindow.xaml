<Window
    x:Class="WebDisplay.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="网页展示 · 设置">
    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.Resources>
            <Style x:Key="SettingsCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="24,20"/>
                <Setter Property="Margin" Value="0,0,0,16"/>
            </Style>
            <Style x:Key="HintTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="LineHeight" Value="19"/>
            </Style>
            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="18"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Margin" Value="0,0,0,16"/>
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="32,24,32,8" Spacing="6">
            <TextBlock Text="网页展示设置" Style="{ThemeResource TitleTextBlockStyle}"/>
            <TextBlock Text="配置展示网页、窗口外观和 Windows 自动化。" Style="{StaticResource HintTextStyle}"/>
        </StackPanel>
        <Pivot x:Name="SettingsPivot" Grid.Row="1" Margin="20,0,20,0">
            <PivotItem Header="网页与展示">
                <ScrollViewer x:Name="DisplayScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8,16,8,12">
                    <StackPanel>
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid ColumnSpacing="24">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Spacing="5" VerticalAlignment="Center">
                                    <TextBlock Text="外观主题" FontSize="18" FontWeight="SemiBold"/>
                                    <TextBlock Text="即时预览；保存后记住你的选择。" Style="{StaticResource HintTextStyle}"/>
                                </StackPanel>
                                <ComboBox x:Name="ThemePreferenceBox" Grid.Column="1" Width="168" VerticalAlignment="Center" AutomationProperties.Name="外观主题" SelectionChanged="ThemePreference_Changed">
                                    <ComboBoxItem Content="跟随系统" Tag="System"/>
                                    <ComboBoxItem Content="浅色" Tag="Light"/>
                                    <ComboBoxItem Content="深色" Tag="Dark"/>
                                </ComboBox>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <TextBlock Text="展示网页" Style="{StaticResource SectionTitleStyle}"/>
                                <TextBox x:Name="UrlBox" Header="网页地址" PlaceholderText="https://example.com" AutomationProperties.Name="网页地址"/>
                                <TextBlock Text="请输入完整的 https:// 或 http:// 地址。需要登录的网站会保留本机浏览器会话。" Style="{StaticResource HintTextStyle}" Margin="0,8,0,18"/>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <TextBox x:Name="ZoomPercentBox" Header="网页缩放（%）" Width="168" Text="100" AutomationProperties.Name="网页缩放百分比"/>
                                    <Button x:Name="ResetZoomButton" Content="恢复100%" VerticalAlignment="Bottom" Click="ResetZoom_Click"/>
                                </StackPanel>
                                <TextBlock Text="可输入 25–500 的整数。100% 为原始大小，保存设置后生效。" Style="{StaticResource HintTextStyle}" Margin="0,8,0,18"/>
                                <ToggleSwitch x:Name="ShowScrollbarsToggle" Header="显示网页滚动条" OnContent="显示" OffContent="隐藏" IsOn="True"/>
                                <TextBlock Text="关闭后仍可用滚轮、触控或键盘滚动。更改此选项并保存后会刷新网页。" Style="{StaticResource HintTextStyle}" Margin="0,8,0,18"/>
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <ToggleSwitch x:Name="RefreshToggle" Header="定时刷新网页" OnContent="已开启" OffContent="已关闭" Toggled="RefreshToggle_Toggled"/>
                                    <TextBox x:Name="RefreshMinutesBox" Grid.Column="1" Header="刷新间隔（分钟）" Width="168" Text="5" MaxLength="5" AutomationProperties.Name="刷新间隔（分钟）"/>
                                </Grid>
                                <TextBlock Text="间隔可设为 1–10080 分钟。" Style="{StaticResource HintTextStyle}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <TextBlock Text="窗口与电源" Style="{StaticResource SectionTitleStyle}"/>
                                <Grid ColumnSpacing="20">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <ToggleSwitch x:Name="TopmostToggle" Header="窗口始终置顶" OnContent="已开启" OffContent="已关闭"/>
                                    <ToggleSwitch x:Name="FullScreenToggle" Grid.Column="1" Header="全屏展示" OnContent="已开启" OffContent="已关闭"/>
                                </Grid>
                                <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="0,20,0,16"/>
                                <ToggleSwitch x:Name="PreventSleepToggle" Header="展示期间防止系统休眠与显示器自动关闭" OnContent="已开启" OffContent="已关闭"/>
                                <TextBlock Text="关闭后遵循 Windows 电源设置；手动锁屏、手动休眠和管理员策略仍然有效。" Style="{StaticResource HintTextStyle}" Margin="0,8,0,18"/>
                                <ToggleSwitch x:Name="StartAtLogonToggle" Header="登录 Windows 后自动启动展示程序" OnContent="已开启" OffContent="已关闭"/>
                                <TextBlock Text="仅适用于当前 Windows 用户。如果自动登录使用其他账号，请登录该账号后开启此选项。开机直接展示还需配置 Windows 自动登录。" Style="{StaticResource HintTextStyle}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                        <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Title="无人值守恢复已启用" Message="断网或网页加载失败后会自动重试；网页进程异常退出时会自动重建浏览器。"/>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>
            <PivotItem Header="系统与账号">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8,16,8,12">
                    <StackPanel>
                        <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Title="系统设置独立应用" Message="本页设置通过各自的按钮立即生效，并会请求 Windows 管理员授权。" Margin="0,0,0,16"/>
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <TextBlock Text="定时重启电脑" Style="{StaticResource SectionTitleStyle}"/>
                                <ToggleSwitch x:Name="RestartToggle" Header="启用定时重启" OnContent="已开启" OffContent="已关闭" Toggled="RestartToggle_Toggled" Margin="0,0,0,16"/>
                                <StackPanel x:Name="RestartOptions">
                                    <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,0,0,16">
                                        <TextBox x:Name="RestartTimeBox" Header="重启时间" Width="128" Text="03:00" MaxLength="5" AutomationProperties.Name="重启时间（24小时制）"/>
                                        <TextBlock Text="24 小时制 · 本机时间" Style="{StaticResource HintTextStyle}" VerticalAlignment="Bottom" Margin="0,0,0,7"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="24" Margin="0,0,0,12">
                                        <RadioButton x:Name="DailyRadio" GroupName="RestartFrequency" Content="每天" Checked="Frequency_Changed"/>
                                        <RadioButton x:Name="WeeklyRadio" GroupName="RestartFrequency" Content="每周指定日期" Checked="Frequency_Changed"/>
                                    </StackPanel>
                                    <Grid x:Name="WeekdayPanel" Margin="0,0,0,12" ColumnSpacing="12" RowSpacing="4" HorizontalAlignment="Left">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <CheckBox x:Name="MondayCheck" Content="周一" Tag="MON"/>
                                        <CheckBox x:Name="TuesdayCheck" Grid.Column="1" Content="周二" Tag="TUE"/>
                                        <CheckBox x:Name="WednesdayCheck" Grid.Column="2" Content="周三" Tag="WED"/>
                                        <CheckBox x:Name="ThursdayCheck" Grid.Column="3" Content="周四" Tag="THU"/>
                                        <CheckBox x:Name="FridayCheck" Grid.Row="1" Content="周五" Tag="FRI"/>
                                        <CheckBox x:Name="SaturdayCheck" Grid.Row="1" Grid.Column="1" Content="周六" Tag="SAT"/>
                                        <CheckBox x:Name="SundayCheck" Grid.Row="1" Grid.Column="2" Content="周日" Tag="SUN"/>
                                    </Grid>
                                </StackPanel>
                                <TextBlock Text="计划由 Windows 执行，即使本程序退出也有效。其他程序未保存的内容可能延迟或阻止重启。" Style="{StaticResource HintTextStyle}" Margin="0,0,0,16"/>
                                <Button x:Name="ApplyRestartButton" Click="ApplyRestart_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE72E;" FontSize="16"/><TextBlock Text="应用重启计划（管理员）"/></StackPanel>
                                </Button>
                                <TextBlock x:Name="RestartStatusText" TextWrapping="Wrap" Style="{StaticResource HintTextStyle}" Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Windows 自动登录" Style="{StaticResource SectionTitleStyle}"/>
                                <TextBlock x:Name="AutoLogonStatusText" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,16" AutomationProperties.LiveSetting="Polite"/>
                                <Grid ColumnSpacing="16" RowSpacing="16" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <TextBox x:Name="UserNameBox" Header="Windows 账号" AutomationProperties.Name="Windows 账号"/>
                                    <TextBox x:Name="DomainBox" Grid.Column="1" Header="域 / 本机名称" AutomationProperties.Name="域或本机名称"/>
                                    <PasswordBox x:Name="AccountPasswordBox" Grid.Row="1" Grid.ColumnSpan="2" Header="账号密码" PasswordRevealMode="Hidden" AutomationProperties.Name="Windows 账号密码"/>
                                </Grid>
                                <TextBlock Text="本地账号使用本机名称作为域。请填写账号密码，而非 Windows Hello PIN；域账号受组织策略约束。密码只用于本次系统配置，不写入程序设置文件。" Style="{StaticResource HintTextStyle}" Margin="0,0,0,16"/>
                                <StackPanel Spacing="12">
                                    <Button x:Name="EnableAutoLogonButton" Click="EnableAutoLogon_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE72E;" FontSize="16"/><TextBlock Text="启用自动登录（管理员）"/></StackPanel>
                                    </Button>
                                    <Button x:Name="DisableAutoLogonButton" Click="DisableAutoLogon_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE72E;" FontSize="16"/><TextBlock Text="关闭自动登录（管理员）"/></StackPanel>
                                    </Button>
                                </StackPanel>
                                <TextBlock x:Name="AutoLogonActionText" Style="{StaticResource HintTextStyle}" Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>
        </Pivot>
        <Border Grid.Row="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="28,16">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="ValidationText" Text="保存将应用展示设置和登录后启动选项。" Style="{StaticResource HintTextStyle}" VerticalAlignment="Center" Margin="0,0,12,0" AutomationProperties.LiveSetting="Assertive"/>
                <Button x:Name="CancelButton" Grid.Column="1" Content="取消" Click="Cancel_Click" MinWidth="88"/>
                <Button x:Name="SaveButton" Grid.Column="2" Content="保存设置" Click="Save_Click" MinWidth="120" Style="{StaticResource AccentButtonStyle}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
