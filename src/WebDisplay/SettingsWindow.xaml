<Window x:Class="WebDisplay.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="网页展示 · 设置" Width="940" Height="800" MinWidth="800" MinHeight="600"
        WindowStartupLocation="CenterOwner" Background="#F3F5F8" Foreground="#243147"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="14"
        Closing="Window_Closing" Closed="Window_Closed">
    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#365FC5"/>
        <Style TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#66758B"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="20"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DFE5ED"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="24,20"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="#C6CFDC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#FCFDFE"/>
            <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="#C6CFDC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#FCFDFE"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,20,12"/>
            <Setter Property="Padding" Value="5,0,0,0"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,24,0"/>
            <Setter Property="Padding" Value="5,0,0,0"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#30445E"/>
            <Setter Property="BorderBrush" Value="#C6CFDC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.82"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.65"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#173A97"/><Setter TargetName="ButtonBorder" Property="BorderThickness" Value="2"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="24,13"/>
            <Setter Property="Foreground" Value="#67778C"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Padding="{TemplateBinding Padding}" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,3">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="#365FC5"/><Setter Property="FontWeight" Value="SemiBold"/><Setter TargetName="TabBorder" Property="BorderBrush" Value="#365FC5"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="#E7ECF7"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="White" BorderBrush="#DFE5ED" BorderThickness="0,0,0,1" Padding="30,24,30,18">
            <StackPanel>
                <TextBlock Text="网页展示设置" FontSize="26" FontWeight="SemiBold"/>
                <TextBlock Text="配置展示网页、运行方式与 Windows 自动化。" Style="{StaticResource Hint}" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>
        <TabControl x:Name="SettingsTabs" Grid.Row="1" Margin="18,8,18,0" BorderThickness="0" Background="Transparent">
            <TabItem Header="网页与展示">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="10,20,10,8" Foreground="#243147" FontWeight="Normal">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="展示网页" Style="{StaticResource SectionTitle}"/>
                                <Label Target="{Binding ElementName=UrlBox}" Content="网页地址" Padding="0,0,0,8"/>
                                <TextBox x:Name="UrlBox" MinHeight="42" AutomationProperties.Name="网页地址"/>
                                <TextBlock Text="输入完整的 https:// 或 http:// 地址。需要登录的网站会保留本机浏览器会话。" Style="{StaticResource Hint}" Margin="0,7,0,20"/>
                                <WrapPanel VerticalAlignment="Center">
                                    <CheckBox x:Name="RefreshCheck" Content="定时刷新网页" Margin="0,0,24,8" VerticalAlignment="Center" Checked="RefreshCheck_Changed" Unchecked="RefreshCheck_Changed"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="每" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBox x:Name="RefreshMinutesBox" Width="94" Text="5" AutomationProperties.Name="刷新间隔（分钟）"/>
                                        <TextBlock Text="分钟刷新一次" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    </StackPanel>
                                </WrapPanel>
                                <TextBlock Text="刷新间隔可设为 1–10080 分钟。" Style="{StaticResource Hint}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="窗口与电源" Style="{StaticResource SectionTitle}"/>
                                <WrapPanel>
                                    <CheckBox x:Name="TopmostCheck" Content="窗口始终置顶"/>
                                    <CheckBox x:Name="FullScreenCheck" Content="全屏展示"/>
                                </WrapPanel>
                                <CheckBox x:Name="PreventSleepCheck" Content="展示期间防止系统休眠与显示器自动关闭" Margin="0,4,0,6"/>
                                <TextBlock Text="关闭此开关后遵循 Windows 电源设置。不会阻止手动锁屏、手动休眠或管理员策略。" Style="{StaticResource Hint}" Margin="0,0,0,16"/>
                                <CheckBox x:Name="StartAtLogonCheck" Content="登录 Windows 后自动启动展示程序" Margin="0,0,0,6"/>
                                <TextBlock Text="此选项仅适用于当前 Windows 用户。若自动登录使用其他账号，请登录该账号后在本程序中开启此选项。开机直接展示还需在“系统与账号”中配置自动登录。" Style="{StaticResource Hint}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#EAF0FD" BorderBrush="#D3DEF5" BorderThickness="1" CornerRadius="8" Padding="18,14">
                            <StackPanel>
                                <TextBlock Text="无人值守恢复已启用" Foreground="#304D91" FontWeight="SemiBold"/>
                                <TextBlock Text="断网或网页加载失败后会自动重试；网页进程异常退出时会自动重建浏览器。" Style="{StaticResource Hint}" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="系统与账号">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="10,20,10,8" Foreground="#243147" FontWeight="Normal">
                    <StackPanel>
                        <TextBlock Text="本页设置通过各自的应用按钮立即生效，并会请求 Windows 管理员授权。" Style="{StaticResource Hint}" Margin="4,0,4,14"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="定时重启电脑" Style="{StaticResource SectionTitle}"/>
                                <CheckBox x:Name="RestartCheck" Content="启用定时重启" Checked="RestartCheck_Changed" Unchecked="RestartCheck_Changed" Margin="0,0,0,16"/>
                                <StackPanel x:Name="RestartOptions">
                                    <WrapPanel Margin="0,0,0,16">
                                        <TextBlock Text="重启时间" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <TextBox x:Name="RestartTimeBox" Width="100" Text="03:00" MaxLength="5" AutomationProperties.Name="重启时间（24小时制）"/>
                                        <TextBlock Text="24 小时制 · 本机时间" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    </WrapPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                        <RadioButton x:Name="DailyRadio" GroupName="RestartFrequency" Content="每天" Checked="Frequency_Changed"/>
                                        <RadioButton x:Name="WeeklyRadio" GroupName="RestartFrequency" Content="每周指定日期" Checked="Frequency_Changed"/>
                                    </StackPanel>
                                    <WrapPanel x:Name="WeekdayPanel" Margin="0,0,0,4">
                                        <CheckBox x:Name="MondayCheck" Content="周一" Tag="MON"/>
                                        <CheckBox x:Name="TuesdayCheck" Content="周二" Tag="TUE"/>
                                        <CheckBox x:Name="WednesdayCheck" Content="周三" Tag="WED"/>
                                        <CheckBox x:Name="ThursdayCheck" Content="周四" Tag="THU"/>
                                        <CheckBox x:Name="FridayCheck" Content="周五" Tag="FRI"/>
                                        <CheckBox x:Name="SaturdayCheck" Content="周六" Tag="SAT"/>
                                        <CheckBox x:Name="SundayCheck" Content="周日" Tag="SUN"/>
                                    </WrapPanel>
                                </StackPanel>
                                <TextBlock Text="计划由 Windows 执行，即使本程序退出也有效。届时会请求重启；其他程序未保存的内容可能延迟或阻止重启。" Style="{StaticResource Hint}" Margin="0,0,0,14"/>
                                <Button x:Name="ApplyRestartButton" Content="应用重启计划（管理员）" HorizontalAlignment="Left" Click="ApplyRestart_Click"/>
                                <TextBlock x:Name="RestartStatusText" Style="{StaticResource Hint}" Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Windows 自动登录" Style="{StaticResource SectionTitle}"/>
                                <TextBlock x:Name="AutoLogonStatusText" Foreground="#365FC5" Margin="0,0,0,14" AutomationProperties.LiveSetting="Polite"/>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <Label Content="Windows 账号" Target="{Binding ElementName=UserNameBox}" Padding="0,0,0,8"/>
                                    <Label Grid.Column="2" Content="域 / 本机名称" Target="{Binding ElementName=DomainBox}" Padding="0,0,0,8"/>
                                    <TextBox x:Name="UserNameBox" Grid.Row="1" AutomationProperties.Name="Windows 账号"/>
                                    <TextBox x:Name="DomainBox" Grid.Row="1" Grid.Column="2" AutomationProperties.Name="域或本机名称"/>
                                    <Label Grid.Row="2" Content="账号密码" Target="{Binding ElementName=AccountPasswordBox}" Padding="0,14,0,8"/>
                                    <PasswordBox x:Name="AccountPasswordBox" Grid.Row="3" Grid.ColumnSpan="3" AutomationProperties.Name="Windows 账号密码"/>
                                </Grid>
                                <TextBlock Text="本地账号使用本机名称作为域。请填写账号密码，而非 Windows Hello PIN；域账号受组织策略约束。密码只用于本次系统配置，不写入程序设置文件。" Style="{StaticResource Hint}" Margin="0,0,0,14"/>
                                <WrapPanel>
                                    <Button x:Name="EnableAutoLogonButton" Content="启用自动登录（管理员）" Click="EnableAutoLogon_Click" Margin="0,0,12,8"/>
                                    <Button x:Name="DisableAutoLogonButton" Content="关闭自动登录（管理员）" Click="DisableAutoLogon_Click" Margin="0,0,0,8"/>
                                </WrapPanel>
                                <TextBlock x:Name="AutoLogonActionText" Style="{StaticResource Hint}" Margin="0,4,0,0" AutomationProperties.LiveSetting="Polite"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
        <Border Grid.Row="2" Background="White" BorderBrush="#DFE5ED" BorderThickness="0,1,0,0" Padding="28,16">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="ValidationText" Text="保存将应用展示设置和登录后启动选项。" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,20,0" AutomationProperties.LiveSetting="Assertive"/>
                <Button x:Name="CancelButton" Grid.Column="1" Content="取消" IsCancel="True" MinWidth="88" Margin="0,0,12,0"/>
                <Button x:Name="SaveButton" Grid.Column="2" Content="保存设置" Click="Save_Click" MinWidth="120" Background="{StaticResource AccentBrush}" Foreground="White" BorderBrush="{StaticResource AccentBrush}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
